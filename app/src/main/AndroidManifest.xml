<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 添加 INTERNET 权限，暂时只能发https的 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 相机权限，运行时还需要动态申请 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- required="false"：没有相机的设备也能安装，避免被应用市场过滤 -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.MyAndroidApp1021">
        <uses-library android:name="com.seuic.uhf" android:required="true" />
        <uses-library android:name="com.seuic.scankey" android:required="true" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MyAndroidApp1021"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
